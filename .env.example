# ============================================
# PreçoCerto — Variáveis de Ambiente
# ============================================
# Copie para .env e preencha os valores.

# ---- Flask ----
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
CORS_ORIGINS=*

# ---- Banco de Dados ----
# Render: preenchido automaticamente pelo DATABASE_URL do PostgreSQL
# Local: ignora (usa SQLite)
DATABASE_URL=

# ---- Cache / TTL ----
CACHE_TTL_HORAS=6
HTTP_TIMEOUT=15

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_BUSCA=20 per minute
RATE_LIMIT_IA=10 per minute

# ---- SerpAPI (Google Shopping) ----
# Criar em: https://serpapi.com
SERPAPI_API_KEY=

# ---- OpenRouter (IA) ----
# Criar em: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---- NVIDIA NIM (IA fallback direto) ----
# Criar em: https://build.nvidia.com (grátis, 1000 req/dia)
# Se OpenRouter falhar, tenta NVIDIA automaticamente
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-70b-instruct
