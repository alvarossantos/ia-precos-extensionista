# Copie este arquivo para ".env" e preencha o que for usar.
# Nada aqui é obrigatório para rodar o projeto — sem as chaves de IA e
# do SerpAPI, o backend simplesmente funciona sem essas fontes/recursos.

# ---- Flask ----
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Em produção, restrinja isto ao domínio real do frontend
# (ex.: CORS_ORIGINS=https://meusite.com,https://www.meusite.com)
CORS_ORIGINS=*

# ---- Cache / TTL ----
CACHE_TTL_HORAS=6

# ---- HTTP (fontes externas) ----
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=2

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_BUSCA=20 per minute
RATE_LIMIT_IA=10 per minute

# ---- Mercado Livre (opcional — busca funciona sem isso) ----
# Necessário só se você quiser limites de uso mais altos via OAuth.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://127.0.0.1:5000/api/ml/callback
# Preenchidos automaticamente pelo fluxo OAuth (/api/ml/auth-url):
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# ---- SerpAPI (opcional — habilita Google Shopping / Google orgânico) ----
SERPAPI_API_KEY=

# ---- OpenRouter (opcional — habilita a Previsão/Análise com IA) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
